  "Commands":{
    "getTotalCPUComsumption": "top -bn1 | grep 'Cpu(s)' | sed 's/.*, *\([0-9.]*\)%* id.*/\1/' | awk '{print 100 - $1}'",
    "getProcessCPUConsumption": "ps -p {pid} -o %cpu | tail -n 1",
    "getMemoryConsumption": "free | grep Mem | awk '{print $3/$2 * 100.0}'",
    "getDiskConsumption": "df -h | awk '$NF==\"/\"{print $5}'",
    "getThreadsCount": "ps -p {pid} -L | wc -l",
    "getKThreadsCount": "ps -p {pid} -L | grep 'kthreadd' | wc -l",
    "getProcessPID": "pidof {processName}"
  }
